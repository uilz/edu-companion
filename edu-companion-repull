#!/bin/bash
# ========================================
# 智能伴学系统 - 一键更新部署脚本
# 在 edu-server 上运行此脚本即可拉取最新代码并重启服务
# ========================================

set -e

PROJECT_DIR="$HOME/edu-companion"
BRANCH="main"

echo "🔄 智能伴学系统 - 更新部署"
echo "================================"

# 1. 拉取最新代码
echo ""
echo "📥 拉取最新代码..."
cd "$PROJECT_DIR"
git fetch origin
LOCAL=$(git rev-parse HEAD)
REMOTE=$(git rev-parse origin/$BRANCH)

if [ "$LOCAL" = "$REMOTE" ]; then
    echo "   ✅ 已是最新版本 ($(git rev-parse --short HEAD))"
else
    echo "   📋 本地: $(git rev-parse --short HEAD)"
    echo "   🌐 远程: $(git rev-parse --short origin/$BRANCH)"
    git pull origin "$BRANCH"
    echo "   ✅ 代码已更新到 $(git rev-parse --short HEAD)"
fi

# 2. 后端依赖更新
echo ""
echo "📦 安装后端依赖..."
cd "$PROJECT_DIR/backend"
source venv/bin/activate
pip install -r requirements.txt -q 2>/dev/null
echo "   ✅ 后端依赖就绪"

# 3. 前端依赖更新 + 构建
echo ""
echo "📦 安装前端依赖..."
cd "$PROJECT_DIR/frontend"
npm install --silent 2>/dev/null
echo "   ✅ 前端依赖就绪"

echo ""
echo "🔨 构建前端..."
# 清除上次构建缓存（避免跨版本兼容问题）
rm -rf .next
npm run build 2>&1
BUILD_EXIT=$?
if [ $BUILD_EXIT -ne 0 ]; then
    echo ""
    echo "   ❌ 前端构建失败 (exit=$BUILD_EXIT)"
    exit 1
fi
echo ""
echo "   ✅ 前端构建完成"

# 4. 环境变量检查 + 数据库设置
echo ""
echo "🔧 检查环境配置..."
cd "$PROJECT_DIR/backend"
source venv/bin/activate

# 确保 .env 存在
if [ ! -f ".env" ]; then
    echo "   ⚠️  .env 不存在，从模板创建..."
    cat > .env << 'ENVEOF'
# 模型配置 (LiteLLM 网关，OpenAI 兼容)
OPENAI_API_KEY=sk-your-key
OPENAI_API_BASE=http://localhost:4000
TEXT_MODEL=openai/gpt-4o-mini
TEXT_REASONING_MODEL=openai/gpt-4o
TEXT_FAST_MODEL=openai/gpt-4o-mini

# 数据库
DB_NAME=edu_companion
DB_USER=companion
DB_PASSWORD=companion123
DB_HOST=localhost
DB_PORT=5432
ENVEOF
    echo "   ⚠️  请编辑 backend/.env 填入 API Key"
fi

# 检测 .env 中是否缺少 DB_PASSWORD，自动补上
if ! grep -q "^DB_PASSWORD=" .env 2>/dev/null; then
    echo "   ⚠️  .env 缺少 DB_PASSWORD，自动补充..."
    cat >> .env << 'ENVEOF'

# 数据库
DB_NAME=edu_companion
DB_USER=companion
DB_PASSWORD=companion123
DB_HOST=localhost
DB_PORT=5432
ENVEOF
fi

# 数据库连接检查
echo ""
echo "🗄️  检查数据库..."
if python -c "
from app.db.database import DB_CONFIG
print(f'  DB: {DB_CONFIG[\"dbname\"]}@{DB_CONFIG[\"host\"]}:{DB_CONFIG[\"port\"]} as {DB_CONFIG[\"user\"]}')
" 2>/dev/null; then
    true
fi

if python -c "
from app.db.database import Database
db = Database.get()
print('connected ok')
" 2>/dev/null; then
    echo "   ✅ 数据库连接正常"
else
    echo "   ❌ 数据库连接失败"
    echo ""
    echo "   📋 请在 edu-server 上执行以下命令初始化数据库:"
    echo ""  
    echo "   sudo -u postgres psql << SQL"
    echo "   CREATE USER companion WITH PASSWORD '你的密码';"
    echo "   CREATE DATABASE edu_companion OWNER companion;"
    echo "   GRANT ALL PRIVILEGES ON DATABASE edu_companion TO companion;"
    echo "   SQL"
    echo ""
    echo "   然后在 backend/.env 中添加:"
    echo "   DB_PASSWORD=你的密码"
    echo ""
    exit 1
fi

# 5. 重启后端
echo ""
echo "🔄 重启后端..."
pkill -f "uvicorn app.main:app" 2>/dev/null || true
sleep 2

cd "$PROJECT_DIR/backend"
source venv/bin/activate
nohup uvicorn app.main:app --host 0.0.0.0 --port 8000 > /tmp/edu-backend.log 2>&1 &
BACKEND_PID=$!
echo "   📝 日志: /tmp/edu-backend.log"
echo "   🆔 PID: $BACKEND_PID"

# 6. 重启前端（生产模式）
echo ""
echo "🔄 重启前端..."
pkill -f "node .next/standalone/server.js" 2>/dev/null || true
sleep 2

# 验证端口已释放
if lsof -i :3000 > /dev/null 2>&1; then
    echo "   ⚠️  3000 端口仍被占用，强制释放..."
    fuser -k 3000/tcp 2>/dev/null || true
    sleep 1
fi

cd "$PROJECT_DIR/frontend"
nohup node .next/standalone/server.js > /tmp/edu-frontend.log 2>&1 &
FRONTEND_PID=$!
echo "   📝 日志: /tmp/edu-frontend.log"
echo "   🆔 PID: $FRONTEND_PID"

# 7. 等待服务就绪
echo ""
echo "⏳ 等待服务启动..."
sleep 5

# 8. 健康检查
echo ""
echo "================================"
echo "🏥 健康检查"

IP=$(hostname -I | awk '{print $1}')
FAIL=0

# 后端根路径
BACKEND_CODE=$(curl -s -o /dev/null -w "%{http_code}" http://localhost:8000/ 2>/dev/null || echo "000")
if [ "$BACKEND_CODE" = "200" ] || [ "$BACKEND_CODE" = "404" ]; then
    echo "   ✅ 后端基础   http://$IP:8000 (HTTP $BACKEND_CODE)"
else
    echo "   ❌ 后端基础   HTTP $BACKEND_CODE"
    FAIL=1
fi

# 知识图谱接口（之前 500 的问题）
GRAPH_CODE=$(curl -s -o /dev/null -w "%{http_code}" "http://localhost:8000/api/knowledge/graph" 2>/dev/null || echo "000")
if [ "$GRAPH_CODE" = "200" ]; then
    echo "   ✅ 知识图谱   /api/knowledge/graph (HTTP $GRAPH_CODE)"
elif [ "$GRAPH_CODE" = "500" ]; then
    echo "   ❌ 知识图谱   HTTP 500 — 检查依赖: pip install networkx"
    FAIL=1
else
    echo "   ⚠️  知识图谱   HTTP $GRAPH_CODE"
fi

# 前端
FRONTEND_CODE=$(curl -s -o /dev/null -w "%{http_code}" http://localhost:3000/ 2>/dev/null || echo "000")
if [ "$FRONTEND_CODE" = "200" ]; then
    echo "   ✅ 前端       http://$IP:3000 (HTTP $FRONTEND_CODE)"
else
    echo "   ❌ 前端       HTTP $FRONTEND_CODE"
    FAIL=1
fi

echo ""

# 9. 失败时打印日志
if [ "$FAIL" -eq 1 ]; then
    echo "================================"
    echo "❌ 部分服务异常，打印最近日志:"
    echo ""
    echo "── 后端日志（最后 20 行）──"
    tail -20 /tmp/edu-backend.log 2>/dev/null || echo "(无日志)"
    echo ""
    echo "── 前端日志（最后 20 行）──"
    tail -20 /tmp/edu-frontend.log 2>/dev/null || echo "(无日志)"
    echo ""
    exit 1
fi

echo "🎉 部署完成！"
echo "   后端: http://$IP:8000"
echo "   前端: http://$IP:3000"
