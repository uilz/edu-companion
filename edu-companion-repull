#!/bin/bash
# ========================================
# 智能伴学系统 - 一键更新部署脚本
# 在 edu-server 上运行此脚本即可拉取最新代码并重启服务
# ========================================

set -e

PROJECT_DIR="$HOME/edu-companion"
BRANCH="main"
NODE="/home/deploy/.nvm/versions/node/v20.20.2/bin/node"
NPM="/home/deploy/.nvm/versions/node/v20.20.2/bin/npm"

echo "🔄 智能伴学系统 - 更新部署"
echo "================================"

# 1. 拉取最新代码
echo ""
echo "📥 拉取最新代码..."
cd "$PROJECT_DIR"
git fetch origin
LOCAL=$(git rev-parse HEAD)
REMOTE=$(git rev-parse origin/$BRANCH)

if [ "$LOCAL" = "$REMOTE" ]; then
    echo "   ✅ 已是最新版本 ($(git rev-parse --short HEAD))"
else
    echo "   📋 本地: $(git rev-parse --short HEAD)"
    echo "   🌐 远程: $(git rev-parse --short origin/$BRANCH)"
    git pull origin "$BRANCH"
    echo "   ✅ 代码已更新到 $(git rev-parse --short HEAD)"
fi

# 2. 后端依赖更新
echo ""
echo "📦 安装后端依赖..."
cd "$PROJECT_DIR/backend"
source venv/bin/activate
pip install -r requirements.txt -q 2>/dev/null
echo "   ✅ 后端依赖就绪"

# 3. 前端依赖更新 + 构建
echo ""
echo "📦 安装前端依赖..."
cd "$PROJECT_DIR/frontend"
npm install --silent 2>/dev/null
echo "   ✅ 前端依赖就绪"

echo ""
echo "🔨 构建前端..."
# 清除上次构建缓存（避免跨版本兼容问题）
rm -rf .next

export PATH="/home/deploy/.nvm/versions/node/v20.20.2/bin:$PATH"
$NPM run build 2>&1
BUILD_EXIT=$?
if [ $BUILD_EXIT -ne 0 ]; then
    echo ""
    echo "   ❌ 前端构建失败 (exit=$BUILD_EXIT)"
    exit 1
fi
echo ""
echo "   ✅ 前端构建完成"

# 复制静态资源到 standalone（Next.js 14 build 后不会自动 copy）
cp -r .next/static .next/standalone/.next/static
echo "   📋 静态资源已复制到 standalone"

# 4. 重启后端 (systemd user service) — 先释放端口
echo ""
echo "🔄 重启后端..."
fuser -k 8000/tcp 2>/dev/null || true
sleep 2
systemctl --user restart edu-backend.service 2>/dev/null || {
    pkill -f "uvicorn app.main:app" 2>/dev/null || true
    sleep 2
}
echo "   ✅ 后端已重启"

# 5. 重启前端 (systemd user service) — 先释放端口防 EADDRINUSE
echo ""
echo "🔄 重启前端..."
fuser -k 3000/tcp 2>/dev/null || true
sleep 2
systemctl --user restart edu-frontend.service 2>/dev/null || {
    # 处理旧进程卡住的情况
    pgrep -f "next-server" | xargs -r kill -9 2>/dev/null || true
    sleep 2
    systemctl --user reset-failed edu-frontend.service 2>/dev/null
    systemctl --user restart edu-frontend.service
}
echo "   ✅ 前端已重启"

# 6. 等待后端就绪
echo ""
echo "⏳ 等待后端就绪..."
for i in $(seq 1 15); do
    CODE=$(curl -s -o /dev/null -w "%{http_code}" http://localhost:8000/health 2>/dev/null || echo "000")
    if [ "$CODE" = "200" ]; then
        echo "   ✅ 后端就绪 (${i}s)"
        break
    fi
    sleep 1
done

# 7. 等待前端就绪
echo ""
echo "⏳ 等待前端就绪..."
for i in $(seq 1 15); do
    CODE=$(curl -s -o /dev/null -w "%{http_code}" -L http://localhost:3000/ 2>/dev/null || echo "000")
    if [ "$CODE" = "200" ]; then
        echo "   ✅ 前端就绪 (${i}s)"
        break
    fi
    sleep 1
done

# 8. 健康检查
echo ""
echo "================================"
echo "🏥 健康检查"

IP=$(hostname -I | awk '{print $1}')
FAIL=0

# 后端
BACKEND_CODE=$(curl -s -o /dev/null -w "%{http_code}" http://localhost:8000/health 2>/dev/null || echo "000")
if [ "$BACKEND_CODE" = "200" ]; then
    echo "   ✅ 后端健康   http://$IP:8000 (HTTP $BACKEND_CODE)"
else
    echo "   ❌ 后端       HTTP $BACKEND_CODE"
    FAIL=1
fi

# 前端
FRONTEND_CODE=$(curl -s -o /dev/null -w "%{http_code}" -L http://localhost:3000/ 2>/dev/null || echo "000")
if [ "$FRONTEND_CODE" = "200" ]; then
    echo "   ✅ 前端       http://$IP:3000 (HTTP $FRONTEND_CODE)"
else
    echo "   ❌ 前端       HTTP $FRONTEND_CODE"
    FAIL=1
fi

echo ""

# 9. 失败时输出
if [ "$FAIL" -eq 1 ]; then
    echo "================================"
    echo "❌ 部分服务异常，打印日志:"
    echo ""
    echo "── 后端日志（最后 10 行）──"
    journalctl --user -u edu-backend.service --no-pager -n 10 2>/dev/null || echo "(无日志)"
    echo ""
    echo "── 前端日志（最后 10 行）──"
    journalctl --user -u edu-frontend.service --no-pager -n 10 2>/dev/null || echo "(无日志)"
    echo ""
    exit 1
fi

echo "🎉 部署完成！"
echo "   后端: http://$IP:8000"
echo "   前端: http://$IP:3000"
