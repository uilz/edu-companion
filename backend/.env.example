# ========================================
# 智能学习伴侣 — 环境变量配置（后端专用）
# 复制此文件为 .env 并填入实际值
# 也可以使用 repo 根目录的 .env（优先加载）
# ========================================

# ── OpenAI 兼容 API（唯一格式） ──
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_API_BASE=https://api.deepseek.com

# ── 文本模型（OpenAI 兼容格式） ──
# 用途说明见 repo 根目录 .env.example
TEXT_MODEL=deepseek/deepseek-chat
TEXT_REASONING_MODEL=deepseek/deepseek-reasoner
TEXT_FAST_MODEL=deepseek/deepseek-chat

# ── 数据库（PostgreSQL） ──
# DB_NAME=edu_companion
# DB_USER=companion
# DB_PASSWORD=companion123
# DB_HOST=localhost
# DB_PORT=5433

# ── 应用配置 ──
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
