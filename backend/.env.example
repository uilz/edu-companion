# ========================================
# 智能学习伴侣 - 环境变量配置
# 复制此文件为 .env 并填入实际值
# ========================================

# ── DeepSeek API（LiteLLM 统一网关）──
DEEPSEEK_API_KEY=sk-your-deepseek-key
OPENAI_API_KEY=sk-your-deepseek-key
OPENAI_API_BASE=https://api.deepseek.com

# ── 模型选择 ──
DEFAULT_MODEL=deepseek/deepseek-v4-flash
REASONING_MODEL=deepseek/deepseek-v4-flash
FAST_MODEL=deepseek/deepseek-v4-flash

# ── 数据库（PostgreSQL）──
# 默认值：edu_companion / companion / companion123 @ localhost:5432
# 如果生产服务器不同，取消注释并修改：
# DB_NAME=edu_companion
# DB_USER=companion
# DB_PASSWORD=companion123
# DB_HOST=localhost
# DB_PORT=5432

# ── 应用配置 ──
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
