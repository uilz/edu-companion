# ========================================
# 智能学习伴侣 — 环境变量示例
# 复制为 .env 后填入实际值
# ========================================

# ── OpenAI 兼容 API ──
OPENAI_API_KEY=sk-your-key-here
OPENAI_API_BASE=https://api.openai.com/v1

# ── 文本模型（OpenAI 兼容格式，如 openai/gpt-4o）──
TEXT_MODEL=openai/gpt-4o-mini
TEXT_REASONING_MODEL=openai/gpt-4o
TEXT_FAST_MODEL=openai/gpt-4o-mini

# ── 应用配置 ──
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000

# ── PostgreSQL 数据库 ──
DB_PASSWORD=your-database-password-here
