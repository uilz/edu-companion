# ── 认证网关配置模板 ──
# 复制此文件为 .env 并填入实际值：
#   cp .env.example .env

# 服务监听
AUTH_GATEWAY_HOST=0.0.0.0
AUTH_GATEWAY_PORT=18001

# CORS 配置（逗号分隔）
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# JWT 配置（生产环境必须修改 JWT_SECRET！）
JWT_SECRET=your-strong-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_HOURS=24
JWT_REFRESH_EXPIRE_DAYS=7

# Cloudflare Turnstile 人机验证
# 从 https://dash.cloudflare.com/?to=/:account/turnstile 获取
TURNSTILE_SECRET_KEY=

# 数据库配置（独立连接池）
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=edu_companion
DB_USER=companion
DB_PASSWORD=your-db-password
DB_POOL_MIN=2
DB_POOL_MAX=5
