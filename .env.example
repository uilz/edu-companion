# ========================================
# 智能学习伴侣 — 环境变量配置
# 复制此文件为 .env 并填入实际值
# ========================================

# ── OpenAI 兼容 API（唯一格式） ──
# 支持任何 OpenAI 兼容端点: DeepSeek / 通义千问 / 本地 Ollama 等
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_API_BASE=https://api.deepseek.com

# ── 文本模型（OpenAI 兼容格式，如 openai/gpt-4o / deepseek/deepseek-chat） ──
# TEXT_MODEL            — 通用对话、知识讲解
# TEXT_REASONING_MODEL  — 复杂题讲解、错题分析、学习规划生成
# TEXT_FAST_MODEL       — 意图分类、情绪识别、工具调用判断
#
# 以后扩展多模态时新增:
#   VISION_MODEL        — 图像理解（当前无）
#   AUDIO_MODEL         — 语音理解（当前无）
#   EMBEDDING_MODEL     — 文本向量化（当前无）
TEXT_MODEL=deepseek/deepseek-chat
TEXT_REASONING_MODEL=deepseek/deepseek-reasoner
TEXT_FAST_MODEL=deepseek/deepseek-chat

# ── 数据库（PostgreSQL） ──
# DB_NAME=edu_companion
# DB_USER=companion
# DB_PASSWORD=companion123
# DB_HOST=localhost
# DB_PORT=5433

# ── 应用配置 ──
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
