# ========================================
# 智能学习伴侣 — 环境变量示例
# 复制为 backend/.env 后填入实际值
# ========================================

# ── OpenAI 兼容 API（唯一格式）──
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_API_BASE=https://api.openai.com/v1

# ── 文本模型（OpenAI 兼容格式）──
TEXT_MODEL=openai/gpt-4o-mini
TEXT_REASONING_MODEL=openai/gpt-4o
TEXT_FAST_MODEL=openai/gpt-4o-mini

# ── 应用配置 ──
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
